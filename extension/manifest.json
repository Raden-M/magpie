{
  "manifest_version": 3,
  "name": "Magpie",
  "version": "0.1.0",
  "description": "Capture highlighted text from the web into your self-hosted Magpie backend.",
  "permissions": ["contextMenus", "storage", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Magpie"
  },
  "commands": {
    "keep-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Keep the current selection in Magpie"
    }
  }
}
