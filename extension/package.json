{
  "name": "magpie-extension",
  "version": "0.1.0",
  "description": "Magpie - capture highlighted text from the web into your self-hosted backend.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raden-M/magpie.git"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:firefox": "node build.mjs --firefox",
    "icons": "node scripts/generate-icons.mjs",
    "watch": "node build.mjs --watch",
    "watch:firefox": "node build.mjs --watch --firefox",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "lint:firefox": "web-ext lint --source-dir=dist-firefox --self-hosted"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "web-ext": "10.7.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.16"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
