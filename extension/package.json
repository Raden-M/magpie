{
  "name": "magpie-extension",
  "version": "0.1.0",
  "description": "Magpie - capture highlighted text from the web into your self-hosted backend.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:firefox": "node build.mjs --firefox",
    "watch": "node build.mjs --watch",
    "watch:firefox": "node build.mjs --watch --firefox",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/chrome": "^0.0.290",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "dompurify": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
