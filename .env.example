# Copy to .env, or let `make docker-up` write one for you.
# Only MAGPIE_TOKEN is required, and only for the container.

# The shared secret between the backend and the extension. Generate with:
#   openssl rand -hex 32
MAGPIE_TOKEN=

# The URL this instance is reached at from outside. Needed when a reverse proxy
# fronts it under a public name: its hostname is allowed automatically, and it
# is what `make connect` tells the extension to pair with. Include the scheme -
# it is never guessed, because a proxy on plain HTTP is a real setup.
# MAGPIE_PUBLIC_URL=https://magpie.example.com

# Further hostnames to answer to, comma separated. Rarely needed: localhost and
# any IP address are always accepted, as is the host of MAGPIE_PUBLIC_URL.
# MAGPIE_ALLOWED_HOSTS=magpie.internal,magpie.old.example.com

# Extension origins allowed via CORS, e.g. chrome-extension://<id>. Not needed
# when the extension holds a host permission for this backend, which is what
# saving its options grants.
# MAGPIE_ALLOWED_ORIGINS=

# Pin a release instead of tracking latest.
# MAGPIE_VERSION=0.2.0

# error | warn | info | debug | trace
# MAGPIE_LOG=info
